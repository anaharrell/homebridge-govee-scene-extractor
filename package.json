{
  "name": "homebridge-govee-scene-extractor",
  "displayName": "Homebridge Govee Scene Extractor",
  "version": "0.5.10",
  "description": "Homebridge plugin that harvests Govee Tap-to-Runs and exposes one HomeKit switch per scene, sent over LAN.",
  "author": {
    "name": "Aaron Harrell",
    "url": "https://github.com/anaharrell"
  },
  "homepage": "https://github.com/anaharrell/homebridge-govee-scene-extractor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anaharrell/homebridge-govee-scene-extractor.git"
  },
  "bugs": {
    "url": "https://github.com/anaharrell/homebridge-govee-scene-extractor/issues"
  },
  "icon": "branding/icon.png",
  "main": "index.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.0.0"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "govee",
    "homekit"
  ],
  "license": "MIT",
  "files": [
    "index.js",
    "lib",
    "homebridge-ui",
    "branding/icon.png",
    "config.schema.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check lib/state.js && node --check lib/ttr-http.js && node --check homebridge-ui/server.js && node --check test/*.js",
    "test": "node --test test/*.js"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6"
  }
}
